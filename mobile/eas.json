{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://apex-service-advisor.preview.emergentagent.com",
        "EXPO_PUBLIC_SENTRY_ENVIRONMENT": "development",
        "EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE": "1.0"
      },
      "ios": {
        "simulator": true
      }
    },
    "device": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://apex-service-advisor.preview.emergentagent.com",
        "EXPO_PUBLIC_SENTRY_ENVIRONMENT": "development",
        "EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE": "1.0"
      },
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "demo": {
      "distribution": "internal",
      "channel": "demo",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://apex-service-advisor.preview.emergentagent.com",
        "EXPO_PUBLIC_SENTRY_ENVIRONMENT": "demo",
        "EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE": "1.0"
      },
      "ios": {
        "simulator": false,
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://apex-service-advisor.preview.emergentagent.com",
        "EXPO_PUBLIC_SENTRY_ENVIRONMENT": "staging",
        "EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE": "1.0"
      },
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://apex-service-advisor.preview.emergentagent.com",
        "EXPO_PUBLIC_SENTRY_ENVIRONMENT": "preview",
        "EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE": "0.5"
      },
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://api.superchargd.com",
        "EXPO_PUBLIC_SENTRY_ENVIRONMENT": "production",
        "EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE": "0.05"
      },
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
