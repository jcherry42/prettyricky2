{
  "expo": {
    "name": "Supercharg'd",
    "slug": "superchargd",
    "scheme": "superchargd",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "platforms": ["ios", "android"],
    "assetBundlePatterns": ["assets/**/*"],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#05070A"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Supercharg'd uses the camera to scan VINs and driver's licenses.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Supercharg'd accesses the photo library to attach license images.",
          "cameraPermission": "Supercharg'd uses the camera to capture license images."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Supercharg'd uses the microphone for the voice push-to-talk translation feature."
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.superchargd.mobile",
      "buildNumber": "1.0.0",
      "requireFullScreen": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Supercharg'd uses the camera to scan VINs and driver's licenses.",
        "NSMicrophoneUsageDescription": "Supercharg'd uses the microphone for the voice push-to-talk translation feature.",
        "NSPhotoLibraryUsageDescription": "Supercharg'd uses the photo library to attach images.",
        "UISupportedInterfaceOrientations": ["UIInterfaceOrientationPortrait"],
        "UIStatusBarStyle": "UIStatusBarStyleLightContent",
        "UIViewControllerBasedStatusBarAppearance": false
      }
    },
    "android": {
      "package": "com.superchargd.mobile",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#05070A"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "pan"
    }
  }
}
