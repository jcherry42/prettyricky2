{
  "appId": "com.superchargd.app",
  "appName": "Supercharg'd",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "ios": {
    "preferredContentMode": "mobile",
    "allowsLinkPreview": false,
    "minVersion": "15.5"
  },
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#1a1512",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#1a1512"
    },
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true
    },
    "ScreenOrientation": {
      "lockOrientation": "portrait"
    },
    "BarcodeScanning": {
      "cameraPermissionText": "Supercharg'd needs camera access to scan VIN barcodes"
    }
  }
}
